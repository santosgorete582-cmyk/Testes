local RunService = game:GetService("RunService")

local TempoSincronizado = 0
local CorAtualSincronizada = Color3.fromRGB(0, 255, 128)

-- Cores do Gradiente Neon (Exclusivo para TextBox)
local CorNeonTopo = Color3.fromRGB(0, 255, 150)
local CorNeonBase = Color3.fromRGB(0, 200, 90)

RunService.RenderStepped:Connect(function(delta)
    TempoSincronizado = TempoSincronizado + delta
    local oscilacao = (math.sin(TempoSincronizado * 1) + 1) / 2 
    local brilho = 0.15 + (oscilacao * 0.85)
    
    -- Mantém a borda externa principal piscando sincronizada
    CorAtualSincronizada = Color3.fromHSV(0.33, 1, brilho)
    
    -- Oscilação sutil do gradiente neon para as TextBox
    CorNeonTopo = Color3.fromHSV(0.35, 1, 0.8 + (oscilacao * 0.2))
    CorNeonBase = Color3.fromHSV(0.35, 0.9, 0.6 + (oscilacao * 0.2))
end)

