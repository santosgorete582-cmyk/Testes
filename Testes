local function updateESP(player)
    if player == Players.LocalPlayer or not espEnabled then return end
    local char = player.Character
    if char and char:FindFirstChild("Head") then
        if billboardGuis[player] then billboardGuis[player]:Destroy() end
        local bill = Instance.new("BillboardGui", char.Head)
        bill.Size = UDim2.new(0,200,0,50)
        bill.AlwaysOnTop = true
        bill.StudsOffset = Vector3.new(0,3,0)
        local lab = Instance.new("TextLabel", bill)
        lab.Size = UDim2.new(1,0,1,0)
        lab.BackgroundTransparency = 1
        lab.Text = player.Name .. " | " .. player.AccountAge .. "d"
        lab.TextColor3 = getESPColor()
        lab.Font = Enum.Font.SourceSansBold
        lab.TextSize = 14
        billboardGuis[player] = bill
    end
end

