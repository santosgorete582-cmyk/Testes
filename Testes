        if gogoConnection then gogoConnection:Disconnect() gogoConnection = nil end
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not state then
            if hum then hum.Sit = false end
            if hrp then 
                hrp.Velocity = Vector3.new(0, 0, 0) 
                hrp.RotVelocity = Vector3.new(0, 0, 0)
            end
            return
        end
        local timeValue = 0
        gogoConnection = RunService.Heartbeat:Connect(function(dt)
            local target = jogadorSelecionado
            if target and target.Character and hrp and hum then
                hum.Sit = true
                timeValue = timeValue + dt * (gogoSpeed or 10)
                local tHead = target.Character:FindFirstChild("Head")
                if tHead then
                    local backAndForth = math.sin(timeValue) * 2
                    hrp.Velocity = Vector3.new(0, 0, 0) 
                    hrp.CFrame = CFrame.new(tHead.Position + tHead.CFrame.LookVector * (2 + backAndForth), tHead.Position)
                end
            else
                if gogoConnection then gogoConnection:Disconnect() gogoConnection = nil end
            end
        end)
    end
})

