local function gerenciarInterfaceSincronizada(objeto)
    -- PROTEÇÃO CRÍTICA: Se não pertencer à ScreenGui do SEU Hub, ignora completamente
    if not MinhaGui or not objeto:IsDescendantOf(MinhaGui) then 
        return 
    end

    -- --- [ SEÇÃO 1: TEXTO BRANCO PURO E NITIDEZ FINA / GRADIENTE NAS TEXTBOX ] ---
    if objeto:IsA("TextBox") then
        local strokeAntigo = objeto:FindFirstChild("BrilhoNeonTexto")
        if strokeAntigo then strokeAntigo:Destroy() end
        
        objeto.TextColor3 = Color3.fromRGB(255, 255, 255)
        objeto.TextStrokeTransparency = 0.4
        objeto.TextStrokeColor3 = Color3.fromRGB(0, 30, 10)
        
        if not objeto:FindFirstChild("TextoGradienteSincronizado") then
            local gradienteTexto = Instance.new("UIGradient")
            gradienteTexto.Name = "TextoGradienteSincronizado"
            gradienteTexto.Rotation = 90
            gradienteTexto.Parent = objeto
            
            RunService.RenderStepped:Connect(function()
                if gradienteTexto and gradienteTexto.Parent then
                    gradienteTexto.Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0, CorNeonTopo),
                        ColorSequenceKeypoint.new(1, CorNeonBase)
                    })
                end
            end)
        end
        
    elseif objeto:IsA("TextLabel") or (objeto:IsA("TextButton") and objeto.Name ~= "Hub") then
        local gradienteAntigo = objeto:FindFirstChild("TextoGradienteSincronizado")
        if gradienteAntigo then gradienteAntigo:Destroy() end
        
        local strokeAntigo = objeto:FindFirstChild("BrilhoNeonTexto")
        if strokeAntigo then strokeAntigo:Destroy() end
        
        objeto.TextColor3 = Color3.fromRGB(255, 255, 255)
        objeto.TextStrokeTransparency = 0.5
        objeto.TextStrokeColor3 = Color3.fromRGB(10, 10, 10)
    end

    -- --- [ SEÇÃO 2: GERENCIAMENTO DE BORDAS EXTERNAS E IMAGENS ] ---
    -- Janela Principal ("Hub")
    if objeto:IsA("ImageButton") and objeto.Name == "Hub" then
        objeto.BackgroundTransparency = 1 
        objeto.Image = "rbxassetid://90718554816272"
        objeto.ImageTransparency = 0 
        objeto.ScaleType = Enum.ScaleType.Stretch
        
        local gradiente = objeto:FindFirstChildOfClass("UIGradient")
        if gradiente then gradiente:Destroy() end
        
        if not objeto:FindFirstChild("BordaJanelaSincronizada") then
            local strokeJanela = Instance.new("UIStroke")
            strokeJanela.Name = "BordaJanelaSincronizada"
            strokeJanela.Thickness = 3 
            strokeJanela.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
            strokeJanela.Parent = objeto
            
            RunService.RenderStepped:Connect(function()
                if strokeJanela and strokeJanela.Parent then
                    strokeJanela.Color = CorAtualSincronizada
                end
            end)
        end
    end

    -- Botão Minimizado
    if objeto:IsA("ImageButton") and objeto.Name ~= "Hub" and (objeto.Image == "rbxassetid://90718554816272" or objeto.Size == UDim2.new(0, 60, 0, 60)) then
        if not objeto:FindFirstChild("BordaVerdeGigante") then
            local strokeBotao = Instance.new("UIStroke")
            strokeBotao.Name = "BordaVerdeGigante"
            strokeBotao.Thickness = 3 
            strokeBotao.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
            strokeBotao.Parent = objeto
            
            local corner = objeto:FindFirstChildOfClass("UICorner")
            if corner then
                corner.CornerRadius = UDim.new(0, 30)
            end
            
            RunService.RenderStepped:Connect(function()
                if strokeBotao and strokeBotao.Parent then
                    strokeBotao.Color = CorAtualSincronizada
                end
            end)
        end
    end

    -- Película do Diálogo
    if objeto:IsA("Frame") and objeto.Name == "Dialog" then
        objeto.BackgroundTransparency = 1
        objeto:GetPropertyChangedSignal("BackgroundTransparency"):Connect(function()
            objeto.BackgroundTransparency = 1
        end)
    end

    -- Corpo do Diálogo
    if objeto:IsA("Frame") and objeto.Parent and objeto.Parent.Name == "Dialog" and objeto.Name ~= "ButtonsHolder" and not objeto:IsA("TextButton") then
        objeto.BackgroundTransparency = 1
        
        local gradienteDialog = objeto:FindFirstChildOfClass("UIGradient")
        if gradienteDialog then gradienteDialog:Destroy() end
        
        if not objeto:FindFirstChild("ImagemFundoDialog") then
            local imagemFundo = Instance.new("ImageLabel")
            imagemFundo.Name = "ImagemFundoDialog"
            imagemFundo.Size = UDim2.fromScale(1, 1)
            imagemFundo.Image = "rbxassetid://90718554816272"
            imagemFundo.ImageTransparency = 0
            imagemFundo.ScaleType = Enum.ScaleType.Stretch
            imagemFundo.BackgroundTransparency = 1
            imagemFundo.Parent = objeto
            
            if imagemFundo.Parent then
                local cloneChildren = {}
                for _, child in pairs(objeto:GetChildren()) do
                    if child ~= imagemFundo then
                        table.insert(cloneChildren, child)
                        child.Parent = nil
                    end
                end
                for _, child in pairs(cloneChildren) do
                    child.Parent = objeto
                end
            end

            local cornerDialog = objeto:FindFirstChildOfClass("UICorner")
            if cornerDialog then
                local imgCorner = Instance.new("UICorner")
                imgCorner.CornerRadius = cornerDialog.CornerRadius
                imgCorner.Parent = imagemFundo
            end
        end

        if not objeto:FindFirstChild("BordaDialogPuraSincronizada") then
            local strokeDialog = Instance.new("UIStroke")
            strokeDialog.Name = "BordaDialogPuraSincronizada"
            strokeDialog.Thickness = 3
            strokeDialog.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
            strokeDialog.Parent = objeto
            
            RunService.RenderStepped:Connect(function()
                if strokeDialog and strokeDialog.Parent then
                    strokeDialog.Color = CorAtualSincronizada
                end
            end)
        end
    end
end

