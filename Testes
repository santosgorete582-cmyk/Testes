    return folder and folder:FindFirstChild("Soccer" .. LocalPlayer.Name)
end

local function ForcarEquipamento()
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildWhichIsA("Humanoid")
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not (backpack and backpack:FindFirstChild("SoccerBall")) and not (character and character:FindFirstChild("SoccerBall")) then
        pcall(function() ReplicatedStorage.RE:FindFirstChild("1Too1l"):InvokeServer("PickingTools", "SoccerBall") end)
        task.wait(0.2)
    end
    local ball = backpack and backpack:FindFirstChild("SoccerBall")
    if ball and humanoid then
        humanoid:EquipTool(ball)
        task.wait(0.05)
        ball:Activate()
    end
end

local function ObterListaNomes()
    local listaNomes = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then table.insert(listaNomes, player.Name) end
    end
    if #listaNomes == 0 then table.insert(listaNomes, "...") end  
    return listaNomes
end

