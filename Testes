-- Função para aplicar velocidade da animação
local function SetAnimationSpeed(speed)
    local p = game.Players.LocalPlayer
    if p and p.Character and p.Character:FindFirstChild("Humanoid") then
        local humanoid = p.Character.Humanoid
        -- Ajusta a velocidade de todas as animações
        if humanoid.Animator then
            -- Para animações ativas
            local animator = humanoid.Animator
            for _, track in pairs(animator:GetPlayingAnimationTracks()) do
                track:AdjustSpeed(speed)
            end
        end
        -- Armazena a velocidade atual para novas animações
        getgenv().AnimationSpeed = speed
    end
end

-- Função para monitorar novas animações
local function SetupAnimationSpeed()
    local p = game.Players.LocalPlayer
    if not p or not p.Character then return end
    
    local humanoid = p.Character:FindFirstChild("Humanoid")
    if not humanoid then return end
    
    -- Cria um Animator se não existir
    local animator = humanoid:FindFirstChild("Animator")
    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = humanoid
    end
    
    -- Monitora novas animações sendo carregadas
    local function onAnimationPlayed(track)
        if getgenv().AnimationSpeedEnabled and getgenv().AnimationSpeed then
            task.wait(0.05) -- Pequeno delay para a animação iniciar
            track:AdjustSpeed(getgenv().AnimationSpeed)
        end
    end
    
    -- Conecta ao evento de novas animações
    if not getgenv().AnimationConnection then
        getgenv().AnimationConnection = animator.AnimationPlayed:Connect(onAnimationPlayed)
    end
end

