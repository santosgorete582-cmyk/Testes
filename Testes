SettingsTab:AddButton({
    Name = "Reentrar no Mesmo Servidor",
    Callback = function()
        pcall(function()
            if #Players:GetPlayers() <= 1 then
                TeleportService:Teleport(game.PlaceId, LocalPlayer)
            else
                TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
            end
        end)
    end
})

-- 7. BOTÃO DE TROCAR DE SERVIDOR)
SettingsTab:AddButton({
    Name = "Trocar para outro Servidor)",
    Callback = function()
        pcall(function()
            local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Desc&limit=100"
            local servidores = HttpService:JSONDecode(game:HttpGet(url))
            local targetId = nil
            
            if servidores and servidores.data then
                for _, server in ipairs(servidores.data) do
                    if server.playing >= 15 and server.playing <= 18 and server.id ~= game.JobId then
                        targetId = server.id
                        break
                    end
                end
            end
            
            if not targetId and servidores and servidores.data then
                for _, server in ipairs(servidores.data) do
                    if server.playing < server.maxPlayers and server.id ~= game.JobId then
                        targetId = server.id
                        break
                    end
                end
            end
            
            if targetId then
                TeleportService:TeleportToPlaceInstance(game.PlaceId, targetId, LocalPlayer)
            end
        end)
    end
})
