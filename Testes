AbaTroll:AddButton({
    Name = "Kill Couch",
    Callback = function()
        local target = jogadorSelecionado
        if not target or not target.Character or not LocalPlayer.Character then return end
        task.spawn(function()
            local char = LocalPlayer.Character
            local root = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            local targetChar = target.Character
            local targetRoot = targetChar:FindFirstChild("HumanoidRootPart") or targetChar:FindFirstChild("LowerTorso")
            local posAnterior = root.CFrame
            local RE_Tool = ReplicatedStorage:WaitForChild("RE"):WaitForChild("1Too1l")
            local RE_Size = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("IncrementBodySize")
            for i = 1, 10 do RE_Size:FireServer(false) end
            task.wait(0.2)
            local couch = char:FindFirstChild("Couch") or LocalPlayer.Backpack:FindFirstChild("Couch")
            if not couch then
                RE_Tool:InvokeServer("PickingTools", "Couch")
                task.wait(0.3)
                couch = LocalPlayer.Backpack:FindFirstChild("Couch")
            end
            if couch and root and hum then
                hum:EquipTool(couch)
                local seat = couch:FindFirstChildWhichIsA("VehicleSeat", true) or couch:FindFirstChildWhichIsA("Seat", true)
                local captured = false
                local startGrab = tick()
                while tick() - startGrab < 5 do 
                    local weld = seat:FindFirstChild("SeatWeld") or seat:FindFirstChildWhichIsA("Weld")
                    if (weld and weld.Part1 and weld.Part1:IsDescendantOf(targetChar)) or (seat.Occupant and seat.Occupant.Parent == targetChar) then 
                        captured = true 
                        break 
                    end
                    local randomRotation = CFrame.Angles(math.rad(math.random(0,360)), math.rad(math.random(0,360)), math.rad(math.random(0,360)))
                    root.CFrame = targetRoot.CFrame * randomRotation
                    RunService.Heartbeat:Wait()
                end
                if captured then
                    local voidCF = CFrame.new(0, -80, 0)
                    for i = 1, 8 do
                        root.CFrame = voidCF
                        RunService.Heartbeat:Wait()
                    end
                    task.wait(1)
                    hum:UnequipTools()
                    root.CFrame = posAnterior
                else
                    root.CFrame = posAnterior
                end
            end
        end)
    end
})
local clonarAtivo = false
local conexaoFisica = nil
local conexaoChat = nil
local alvoAtual = nil                                                                                                                                                                                                                                                         AbaTroll:AddToggle({
    Name = "Clonar física",
    Description = "clone as físicas do jogador como movimentos, pulo ,chat, rotação, sentar",
    Default = false,
    Callback = function(Value)
        clonarAtivo = Value
        local TextChatService = game:GetService("TextChatService")  
        local PlayerScripts = LocalPlayer:WaitForChild("PlayerScripts")  
        local PlayerModule = require(PlayerScripts:WaitForChild("PlayerModule"))  
        local Controls = PlayerModule:GetControls()  
        if not clonarAtivo then  
            if conexaoFisica then conexaoFisica:Disconnect() conexaoFisica = nil end  
            if conexaoChat then conexaoChat:Disconnect() conexaoChat = nil end  
            alvoAtual = nil  
            pcall(function() LocalPlayer.Character.Humanoid.Sit = false end)  
            Controls:Enable()  
            return  
        end  
        Controls:Disable()  
        conexaoFisica = RunService.Heartbeat:Connect(function()  
            if not clonarAtivo or not LocalPlayer.Character or not jogadorSelecionado then return end  
            if jogadorSelecionado ~= alvoAtual then  
                if conexaoChat then conexaoChat:Disconnect() end  
                alvoAtual = jogadorSelecionado  
                conexaoChat = alvoAtual.Chatted:Connect(function(msg)  
                    if clonarAtivo and alvoAtual == jogadorSelecionado then  
                        local textoExato = (type(msg) == "userdata" and msg.Text) or msg  
                        if textoExato == "" or string.sub(textoExato, 1, 1) == "/" then return end  
                        task.spawn(function()  
                            if TextChatService and TextChatService.ChatInputBarConfiguration and TextChatService.ChatInputBarConfiguration.TargetTextChannel then  
                                TextChatService.ChatInputBarConfiguration.TargetTextChannel:SendAsync(textoExato)  
                            else  
                                local chatEvent = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents") or ReplicatedStorage:FindFirstChild("chat")  
                                if chatEvent and chatEvent:FindFirstChild("SayMessageRequest") then chatEvent.SayMessageRequest:FireServer(textoExato, "All") end  
                            end  
                        end)  
                    end  
                end)  
            end  
            local alvoChar = jogadorSelecionado.Character  
            local meuChar = LocalPlayer.Character  
            if alvoChar and meuChar then  
                local alvoRoot = alvoChar:FindFirstChild("HumanoidRootPart")  
                local meuRoot = meuChar:FindFirstChild("HumanoidRootPart")  
                local alvoHumanoid = alvoChar:FindFirstChildWhichIsA("Humanoid")  
                local meuHumanoid = meuChar:FindFirstChildWhichIsA("Humanoid")  
                if alvoRoot and meuRoot and alvoHumanoid and meuHumanoid then  
                    meuHumanoid.Sit = alvoHumanoid.Sit  
                    local deslocamentoLateral = alvoRoot.CFrame * CFrame.new(5, 0, 0)  
                    local alturaFinalY = deslocamentoLateral.Position.Y  
                    if alvoHumanoid.FloorMaterial ~= Enum.Material.Air and not alvoHumanoid.Sit then  
                        alturaFinalY = alvoRoot.Position.Y - ((alvoHumanoid.HipHeight or 0) - (meuHumanoid.HipHeight or 0))  
                    end  
                    meuRoot.CFrame = CFrame.new(desocamentoLateral.Position.X, alturaFinalY, deslocamentoLateral.Position.Z) * (alvoRoot.CFrame - alvoRoot.CFrame.Position)  
                    if alvoHumanoid.Sit then  
                        meuHumanoid:ChangeState(Enum.HumanoidStateType.Seated)  
                        meuRoot.AssemblyLinearVelocity = alvoRoot.AssemblyLinearVelocity  
                    else  
                        if alvoHumanoid.FloorMaterial == Enum.Material.Air then  
                            if alvoRoot.AssemblyLinearVelocity.Y > 0 then meuHumanoid.Jump = true meuHumanoid:ChangeState(Enum.HumanoidStateType.Jumping) else meuHumanoid:ChangeState(Enum.HumanoidStateType.Freefall) end  
                            meuRoot.AssemblyLinearVelocity = Vector3.new(0, alvoRoot.AssemblyLinearVelocity.Y, 0)  
                        else  
                            if alvoHumanoid.MoveDirection.Magnitude > 0 then meuHumanoid:ChangeState(Enum.HumanoidStateType.Running) meuRoot.AssemblyLinearVelocity = alvoRoot.AssemblyLinearVelocity else meuRoot.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end  
                        end  
                    end  
                end  
            end  
        end)
    end
})

