-- ========== ESP (Wallhack) ATUALIZAÇÃO AUTOMÁTICA PERFEITA ==========
local espObjects = {}
local espConnections = {}
local globalConnections = {}

-- Aplica o estilo atual do ESP a um highlight
local function ApplyStyle(highlight)
    if not highlight then return end
    local espType = getgenv().ESPType or "normal"
    local espColor = getgenv().ESPColor or Color3.fromRGB(255, 0, 0)

    if espType == "normal" then
        highlight.FillTransparency = 1
        highlight.OutlineTransparency = 0
        highlight.OutlineColor = espColor
    elseif espType == "inteiro" then
        highlight.FillTransparency = 0.3
        highlight.OutlineTransparency = 1
        highlight.FillColor = espColor
    elseif espType == "nítido" then
        highlight.FillTransparency = 0.3
        highlight.OutlineTransparency = 0
        highlight.FillColor = espColor
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    end
end

-- Adiciona ESP a um jogador específico (sem duplicar)
local function AddESPToPlayer(player)
    if not player or player == game.Players.LocalPlayer then return end
    if espObjects[player.Name] then return end

    local function createHighlight()
        if not player.Character then return end
        local highlight = Instance.new("Highlight")
        highlight.Name = "ESP_Highlight"
        highlight.Adornee = player.Character
        highlight.Parent = player.Character
        ApplyStyle(highlight)
        espObjects[player.Name] = highlight
    end

    if player.Character then
        createHighlight()
    end

    local charConn
    charConn = player.CharacterAdded:Connect(function()
        task.wait()
        if espObjects[player.Name] then
            espObjects[player.Name]:Destroy()
            espObjects[player.Name] = nil
        end
        createHighlight()
    end)

    if not espConnections[player.Name] then
        espConnections[player.Name] = {}
    end
    table.insert(espConnections[player.Name], charConn)
end

-- Remove ESP de um jogador e todas as suas conexões
local function RemoveESPFromPlayer(player)
    if espObjects[player.Name] then
        espObjects[player.Name]:Destroy()
        espObjects[player.Name] = nil
    end
    if espConnections[player.Name] then
        for _, conn in pairs(espConnections[player.Name]) do
            conn:Disconnect()
        end
        espConnections[player.Name] = nil
    end
end

-- Atualiza todos os ESPs ativos
local function UpdateAllESP()
    for _, highlight in pairs(espObjects) do
        ApplyStyle(highlight)
    end
end

-- Liga o ESP globalmente
local function EnableESP()
    if getgenv().ESPEnabled then return end
    getgenv().ESPEnabled = true

    local players = game:GetService("Players")
    local localPlayer = players.LocalPlayer

    for _, player in pairs(players:GetPlayers()) do
        if player ~= localPlayer then
            AddESPToPlayer(player)
        end
    end

    local playerAddedConn = players.PlayerAdded:Connect(function(player)
        if player ~= localPlayer and getgenv().ESPEnabled then
            AddESPToPlayer(player)
        end
    end)

    local playerRemovingConn = players.PlayerRemoving:Connect(function(player)
        if getgenv().ESPEnabled then
            RemoveESPFromPlayer(player)
        end
    end)

    globalConnections.PlayerAdded = playerAddedConn
    globalConnections.PlayerRemoving = playerRemovingConn
end

-- Desliga o ESP globalmente
local function DisableESP()
    if not getgenv().ESPEnabled then return end
    getgenv().ESPEnabled = false

    for playerName, highlight in pairs(espObjects) do
        if highlight then highlight:Destroy() end
    end
    espObjects = {}

    for _, connList in pairs(espConnections) do
        for _, conn in pairs(connList) do
            conn:Disconnect()
        end
    end
    espConnections = {}

    if globalConnections.PlayerAdded then
        globalConnections.PlayerAdded:Disconnect()
        globalConnections.PlayerAdded = nil
    end
    if globalConnections.PlayerRemoving then
        globalConnections.PlayerRemoving:Disconnect()
        globalConnections.PlayerRemoving = nil
    end
end

