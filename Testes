AbaTroll:AddToggle({
    Name = "Orbitar em Mim",
    Default = false,
    Callback = function(state)
        OrbitSelfEnabled = state
        if state then 
            OrbitTargetEnabled = false
            ForcarEquipamento()
            task.spawn(function()
                while OrbitSelfEnabled do
                    local character = LocalPlayer.Character
                    local backpack = LocalPlayer:FindFirstChild("Backpack")
                    if backpack and backpack:FindFirstChild("SoccerBall") then ForcarEquipamento() end
                    local ball = GetBall()
                    local hrp = character and character:FindFirstChild("HumanoidRootPart")
                    if ball and hrp then
                        local part = ball:IsA("BasePart") and ball or ball:FindFirstChildWhichIsA("BasePart", true)
                        if part then
                            part.CanCollide = true
                            if part.Anchored then part.Anchored = false end
                            OrbitAngle = OrbitAngle + (OrbitSpeed / 100)
                            local ox = math.cos(OrbitAngle) * OrbitDistance
                            local oz = math.sin(OrbitAngle) * OrbitDistance
                            part.AssemblyLinearVelocity = Vector3.new(0, 0.01, 0)
                            part.CFrame = hrp.CFrame * CFrame.new(ox, OrbitHeight, oz)
                        end
                    end
                    RunService.Heartbeat:Wait()
                end
            end)
        end
    end
})

