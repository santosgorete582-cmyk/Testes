task.spawn(function()
    local angle, tempoGeral = 0, 0
    game:GetService("RunService").Heartbeat:Connect(function(dt)
        if (PropMovementMode == "Nenhum" and not ModoAvancadoAtivo) or #meusPropsCache == 0 then return end
        local lista = {}
        if selecionarTodos then
            for _, p in ipairs(Players:GetPlayers()) do if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then table.insert(lista, p) end end
        else local t = jogadorSelecionado or LocalPlayer if t.Character and t.Character:FindFirstChild("HumanoidRootPart") then table.insert(lista, t) end end
        if #lista == 0 then return end
        
        local cfg = Configs[PropMovementMode]
        local speedVal = cfg and cfg.Speed or 2
        angle, tempoGeral = angle + (dt * speedVal), tempoGeral + dt * (speedVal * 2)
        local total, shift = #meusPropsCache, selecionarTodos and math.floor(tick() * 30) or 0

        for i, prop in ipairs(meusPropsCache) do
            local remote = prop:FindFirstChild("SetCurrentCFrame")
            if remote then
                local pDono = lista[((i - 1 + shift) % #lista) + 1]
                if pDono and pDono.Character and pDono.Character:FindFirstChild("HumanoidRootPart") then
                    local root = pDono.Character.HumanoidRootPart
                    local rPos, rCF = root.Position, root.CFrame
                    local pFrente, spacing = rPos + (rCF.LookVector * 5), (math.pi * 2) / total
                    local fAngle, tPos, olharPara = angle + (i * spacing) + (shift * 0.5), Vector3.zero, rPos

                    if ModoAvancadoAtivo then
                        local humAlvo = pDono.Character:FindFirstChildWhichIsA("Humanoid")
                        if humAlvo and (humAlvo.SeatPart or humAlvo.Sit) then
                            local posVoid = Vector3.new(rPos.X, -40000, rPos.Z)
                            task.spawn(function() pcall(remote.InvokeServer, remote, rCF - rCF.Position + posVoid) end)
                        else
                            local oscilacaoRapida = Vector3.new(0, math.sin(tempoGeral * 15 + i) * 3, 0)
                            task.spawn(function() pcall(remote.InvokeServer, remote, rCF + oscilacaoRapida) end)
                        end
                    elseif cfg then
                        if PropMovementMode == "Orbita" then tPos = rPos + Vector3.new(math.cos(fAngle) * cfg.Distance, cfg.Height, math.sin(fAngle) * cfg.Distance)
                        elseif PropMovementMode == "Aura" then local o = math.sin(tempoGeral * 3 + i) * 1.5 tPos = rPos + Vector3.new(math.cos(fAngle * 1.5) * (cfg.Distance + (o * 0.2)), cfg.Height + o, math.sin(fAngle * 1.5) * (cfg.Distance + (o * 0.2))) olharPara = rPos + Vector3.new(0, o, 0)
                        elseif PropMovementMode == "Tremor" then tPos = rPos + Vector3.new(math.cos(fAngle) * cfg.Distance, cfg.Height, math.sin(fAngle) * cfg.Distance) + Vector3.new(math.sin(tick() * 50 + i) * 0.8, math.cos(tick() * 55 + i) * 0.8, math.sin(tick() * 60 + i) * 0.8)
                        elseif PropMovementMode == "Caotico" then tPos = rPos + Vector3.new(math.cos(fAngle) * cfg.Distance, cfg.Height, math.sin(fAngle) * cfg.Distance) + Vector3.new(math.sin(tempoGeral + (i * 2)) * (cfg.Distance * 0.5), math.cos(tempoGeral * 1.8 + i) * 4, math.sin(tempoGeral * 1.3 + i) * (cfg.Distance * 0.5)) olharPara = tPos + Vector3.new(math.sin(tempoGeral * 5), math.cos(tempoGeral * 5), math.sin(tempoGeral * 3))
                        elseif PropMovementMode == "Estrela" then local e = cfg.Distance + (math.sin(tempoGeral * 2.5 + i) * (cfg.Distance * 0.4)) tPos = rPos + Vector3.new(math.cos(fAngle) * e, cfg.Height + (math.cos(fAngle) * 2), math.sin(fAngle) * e) olharPara = rPos + Vector3.new(0, cfg.Height, 0)
                        elseif PropMovementMode == "Alinhamento" then tPos = rPos + (rCF.LookVector * (-5 - (i * cfg.Distance))) + Vector3.new(0, cfg.Height + (math.sin(tempoGeral + i) * 0.5), 0) olharPara = tPos - (rCF.LookVector * 100)
                        elseif PropMovementMode == "Furacao" then local s = ((tempoGeral + (i * 2)) % 10) - 3 tPos = pFrente + Vector3.new(math.cos(fAngle * 1.5) * (cfg.Distance * (1 - (s / 15))), cfg.Height + s, math.sin(fAngle * 1.5) * (cfg.Distance * (1 - (s / 15)))) olharPara = pFrente + Vector3.new(0, 10, 0)
                        elseif PropMovementMode == "Portal" then local rp = cfg.Distance * 0.7 tPos = (rCF * CFrame.new(0, cfg.Height + (math.sin(fAngle) * rp), -5)).Position + (rCF.RightVector * (math.cos(fAngle) * rp)) olharPara = pFrente + (rCF.LookVector * 20) end
                        
                        task.spawn(function() pcall(remote.InvokeServer, remote, CFrame.lookAt(tPos, olharPara)) end)
                    end
                end
            end
        end
    end)
end)

