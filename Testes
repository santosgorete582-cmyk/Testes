local HttpService = game:GetService("HttpService")
local TeleportService = game:GetService("TeleportService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local ARQUIVO_SERVIDORES = "TachosHub_SavedServers.json"
local ServidoresSalvos = {}
local NomeDoServidorDigitado = ""
local ServidorSelecionado = ""

-- Carrega a lista de servidores salvos do arquivo
if isfile and isfile(ARQUIVO_SERVIDORES) then
    local sucesso, resultado = pcall(function()
        return HttpService:JSONDecode(readfile(ARQUIVO_SERVIDORES))
    end)
    if sucesso and type(resultado) == "table" then
        ServidoresSalvos = resultado
    end
end

-- Função interna para salvar a lista atualizada no dispositivo
local function SalvarDadosNoArquivo()
    if writefile then
        pcall(function()
            writefile(ARQUIVO_SERVIDORES, HttpService:JSONEncode(ServidoresSalvos))
        end)
    end
end

-- Função para gerar a lista de nomes para o Dropdown
local function ObterListaParaDropdown()
    local lista = {}
    for nome, _ in pairs(ServidoresSalvos) do
        table.insert(lista, nome)
    end
    if #lista == 0 then
        table.insert(lista, "Nenhum servidor salvo")
    end
    return lista
end

-- --------------------------------------------------------------------
-- CRIAÇÃO DA SETTINGS TAB
-- --------------------------------------------------------------------
local SettingsTab = Window:MakeTab({Title = "Settings", Icon = "settings"})

SettingsTab:AddSection({"Salvar e Gerenciar Servidores"})

-- 1. BARRA DE PESQUISA / INPUT (Para digitar o nome do servidor)
local TextBoxNome = SettingsTab:AddTextBox({
    Name = "Nome do Servidor",
    Default = "",
    PlaceholderText = "Digite um nome e aperte Enter...",
    ClearTextOnFocus = true,
    Callback = function(texto)
        NomeDoServidorDigitado = texto
    end
})

-- Declaração antecipada do Dropdown para automação
local DropdownServidores

-- FUNÇÃO CRÍTICA: Força a Redz V5 a atualizar o Dropdown visualmente na hora
local function VisualRefreshDropdown()
    if DropdownServidores then
        local novasOpcoes = ObterListaParaDropdown()
        
        -- Tenta os 3 métodos possíveis de atualização da Redz Library V5
        pcall(function()
            if type(DropdownServidores.SetOptions) == "function" then
                DropdownServidores:SetOptions(novasOpcoes)
            elseif type(DropdownServidores.Refresh) == "function" then
                DropdownServidores:Refresh(novasOpcoes)
            elseif type(DropdownServidores.Update) == "function" then
                DropdownServidores:Update(novasOpcoes)
            end
        end)
    end
end

-- 2. BOTÃO PARA SALVAR O SERVIDOR ATUAL
SettingsTab:AddButton({
    Name = "Salvar Servidor Atual",
    Callback = function()
        if NomeDoServidorDigitado == "" or NomeDoServidorDigitado == nil then
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "Tachos Hub",
                Text = "Por favor, digite um nome na barra acima!",
                Duration = 3
            })
            return
        end
        
        -- Salva o JobId atual atrelado ao nome digitado
        ServidoresSalvos[NomeDoServidorDigitado] = game.JobId
        SalvarDadosNoArquivo()
        
        -- Executa a atualização automática no dropdown
        VisualRefreshDropdown()
        
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Tachos Hub",
            Text = "Servidor '" .. NomeDoServidorDigitado .. "' salvo!",
            Duration = 3
        })
    end
})

-- 3. DROPDOWN (Lista dos servidores armazenados)
DropdownServidores = SettingsTab:AddDropdown({
    Name = "Selecione um Servidor Salvo",
    Options = ObterListaParaDropdown(),
    Default = "",
    Callback = function(opcao)
        if opcao ~= "Nenhum servidor salvo" then
            ServidorSelecionado = opcao
        else
            ServidorSelecionado = ""
        end
    end
})

-- 4. BOTÃO PARA ENTRAR NO SERVIDOR SELECIONADO
SettingsTab:AddButton({
    Name = "Entrar no Servidor Selecionado",
    Callback = function()
        if ServidorSelecionado == "" or ServidorSelecionado == nil or ServidorSelecionado == "Nenhum servidor salvo" then
            return
        end
        
        local targetJobId = ServidoresSalvos[ServidorSelecionado]
        if targetJobId then
            pcall(function()
                TeleportService:TeleportToPlaceInstance(game.PlaceId, targetJobId, LocalPlayer)
            end)
        end
    end
})

-- 5. BOTÃO PARA EXCLUIR O SERVIDOR SELECIONADO
SettingsTab:AddButton({
    Name = "Excluir Servidor Selecionado",
    Callback = function()
        if ServidorSelecionado == "" or ServidorSelecionado == nil or ServidorSelecionado == "Nenhum servidor salvo" then
            return
        end
        
        -- Remove da tabela e salva a alteração no arquivo
        ServidoresSalvos[ServidorSelecionado] = nil
        SalvarDadosNoArquivo()
        
        -- Reseta a variável de escolha
        ServidorSelecionado = ""
        
        -- Executa a atualização automática no dropdown
        VisualRefreshDropdown()
        
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Tachos Hub",
            Text = "Servidor excluído com sucesso!",
            Duration = 3
        })
    end
})

SettingsTab:AddSection({"Atalhos Rápidos"})

